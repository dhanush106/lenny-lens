DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/lennylens
SECRET_KEY=replace-with-a-long-random-development-secret
ENVIRONMENT=development
LLM_PROVIDER=ollama
# Choose a locally installed chat model. qwen3.5:2b is a practical default.
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_PROVIDER=ollama
# `all-minilm` returns 384-dimensional embeddings, matching the pgvector schema.
OLLAMA_EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSIONS=384
## Use lexical retrieval until Ollama's embedding endpoint is enabled; set to
## semantic only after re-ingesting with the configured embedding model.
RETRIEVAL_MODE=lexical
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_MAX_PER_TRANSCRIPT=2
# ANTHROPIC_API_KEY=your_key_here
# To use a cloud model, set LLM_PROVIDER=openai or LLM_PROVIDER=anthropic and
# provide the matching key/model below. Restart the backend after changing .env.
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-3-haiku-20240307
